# Environment Variables for OnlineMBAAdmission.com
# Copy this file to .env for local testing or configure these in Vercel / Hostinger settings.

# 1. NeoDove CRM Webhook URL (Mandatory for CRM forwarding)
# Obtain this webhook URL from your NeoDove Integration Dashboard.
NEODOVE_LEADS_URL=https://your-tenant-id.neodove.com/integration/custom/your-secret-token/leads

# 2. Distributed Rate Limiting via Upstash Redis REST API (Optional for Vercel multi-instance serverless)
# If left blank, api/lead.js falls back to local in-memory sliding window rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
