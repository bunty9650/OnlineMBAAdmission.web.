# Apache / LiteSpeed Rules for Hostinger (Clean Extensionless URLs & Canonical Host)
Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Enforce Canonical Host (https://www.onlinembaadmission.com)
RewriteCond %{HTTP_HOST} ^onlinembaadmission\.com [NC]
RewriteRule ^(.*)$ https://www.onlinembaadmission.com/$1 [L,R=301]

# 2. Strip Search Query Param on /universities
RewriteCond %{QUERY_STRING} ^q=.*$ [NC]
RewriteRule ^universities/?$ /universities? [R=301,L]

# 3. API Route for Lead Submissions
RewriteRule ^api/lead/?$ php/lead.php [L,QSA]

# 4. Legacy University URLs to /universities/{slug}
RewriteRule ^university-ignou-online(\.html)?$ /universities/ignou [R=301,L]
RewriteRule ^university-amity-online(\.html)?$ /universities/amity [R=301,L]
RewriteRule ^university-manipal-online(\.html)?$ /universities/manipal-jaipur [R=301,L]
RewriteRule ^university-du-sol-online(\.html)?$ /universities/du-sol [R=301,L]
RewriteRule ^university-gla-online(\.html)?$ /universities/gla [R=301,L]
RewriteRule ^university-andhra-online(\.html)?$ /universities/andhra-university [R=301,L]
RewriteRule ^university-ccsu-online(\.html)?$ /universities/ccsu [R=301,L]
RewriteRule ^university-parul-online(\.html)?$ /universities/parul [R=301,L]
RewriteRule ^university-imt-ghaziabad-online(\.html)?$ /universities/imt-ghaziabad [R=301,L]
RewriteRule ^university-symbiosis-online(\.html)?$ /universities/symbiosis [R=301,L]
RewriteRule ^university-kj-somaiya-online(\.html)?$ /universities/kj-somaiya [R=301,L]
RewriteRule ^university-imi-kolkata-online(\.html)?$ /universities/imi-kolkata [R=301,L]
RewriteRule ^university-chandigarh-online(\.html)?$ /universities/chandigarh-university [R=301,L]
RewriteRule ^university-chandigarh-university-online(\.html)?$ /universities/chandigarh-university [R=301,L]

# 5. Legacy / Singular / Plural University Routes
RewriteRule ^universities/([^/]+)/mba-in-([^/]+)/?$ /university/$1/mba-in-$2 [R=301,L]
RewriteRule ^university/([^/]+)/?$ /universities/$1 [R=301,L]

# 6. Compare and Contact URLs
RewriteRule ^compare(\.html)?$ /comparison [R=301,L]
RewriteRule ^contact(\.html)?$ /admission [R=301,L]

# 7. Duplicate Specialization URLs to Canonical Full Slugs
RewriteRule ^specializations/banking-finance(\.html)?$ /specializations/banking-and-finance [R=301,L]
RewriteRule ^specializations/business-ai(\.html)?$ /specializations/ai-for-business [R=301,L]
RewriteRule ^specializations/fintech(\.html)?$ /specializations/fintech-and-financial-services [R=301,L]
RewriteRule ^specializations/supply-chain(\.html)?$ /specializations/supply-chain-management [R=301,L]
RewriteRule ^specializations/sustainability-esg(\.html)?$ /specializations/sustainability-and-esg-management [R=301,L]

# 8. Legacy Blog URLs to /blogs/{slug}
RewriteRule ^blogs/ignou-online-mba-admission-(2026|2027)/?$ /universities/ignou [R=301,L]
RewriteRule ^blog-direct-admission-without-cat(\.html)?$ /blogs/direct-admission-without-cat [R=301,L]
RewriteRule ^blog-highest-paying-specializations(\.html)?$ /blogs/highest-paying-specializations [R=301,L]
RewriteRule ^blog-is-online-mba-valid-govt-jobs(\.html)?$ /blogs/is-online-mba-valid-govt-jobs [R=301,L]
RewriteRule ^blog-no-cost-emi-guide(\.html)?$ /blogs/no-cost-emi-guide [R=301,L]
RewriteRule ^blog-online-vs-distance-mba(\.html)?$ /blogs/online-vs-distance-mba [R=301,L]
RewriteRule ^blog-ugc-deb-approval-guide(\.html)?$ /blogs/ugc-deb-approval-guide [R=301,L]
RewriteRule ^blogs-(direct-admission-without-cat|highest-paying-specializations|is-online-mba-valid-govt-jobs|no-cost-emi-guide|online-vs-distance-mba|ugc-deb-approval-guide)(\.html)?$ /blogs/$1 [R=301,L]
RewriteRule ^blog/?$ /blogs [R=301,L]
RewriteRule ^blog/(.*)$ /blogs/$1 [R=301,L]
RewriteRule ^blogs/page/2/?$ /blogs/page-2 [R=301,L]

# 9. Redirect external requests from .html to clean extensionless URLs (301 Permanent)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# 10. Internally route clean URL /slug to slug.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

# 11. Internally route directory without trailing slash to directory/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [NC,L]

DirectoryIndex index.html

# Protect internal backup logs, rate limiters, and environment files from web access
<FilesMatch "^(leads_backup\.jsonl|rate_lead_.*|\.env.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Security & Caching for Hostinger LiteSpeed / Apache
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>
