  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/compare", "destination": "/comparison", "permanent": true },
    { "source": "/compare.html", "destination": "/comparison", "permanent": true },
    { "source": "/blog", "destination": "/blogs", "permanent": true },
    { "source": "/blogs/page/2", "destination": "/blogs/page-2", "permanent": true },
    { "source": "/blog/:match*", "destination": "/blogs/:match*", "permanent": true },
    { "source": "/blog-direct-admission-without-cat", "destination": "/blogs/direct-admission-without-cat", "permanent": true },
    { "source": "/blog-highest-paying-specializations", "destination": "/blogs/highest-paying-specializations", "permanent": true },
    { "source": "/blog-is-online-mba-valid-govt-jobs", "destination": "/blogs/is-online-mba-valid-govt-jobs", "permanent": true },
    { "source": "/blog-no-cost-emi-guide", "destination": "/blogs/no-cost-emi-guide", "permanent": true },
    { "source": "/blog-online-vs-distance-mba", "destination": "/blogs/online-vs-distance-mba", "permanent": true },
    { "source": "/blog-ugc-deb-approval-guide", "destination": "/blogs/ugc-deb-approval-guide", "permanent": true },
    { "source": "/blogs-direct-admission-without-cat", "destination": "/blogs/direct-admission-without-cat", "permanent": true },
    { "source": "/blogs-highest-paying-specializations", "destination": "/blogs/highest-paying-specializations", "permanent": true },
    { "source": "/blogs-is-online-mba-valid-govt-jobs", "destination": "/blogs/is-online-mba-valid-govt-jobs", "permanent": true },
    { "source": "/blogs-no-cost-emi-guide", "destination": "/blogs/no-cost-emi-guide", "permanent": true },
    { "source": "/blogs-online-vs-distance-mba", "destination": "/blogs/online-vs-distance-mba", "permanent": true },
    { "source": "/blogs-ugc-deb-approval-guide", "destination": "/blogs/ugc-deb-approval-guide", "permanent": true },
    { "source": "/specializations/banking-finance", "destination": "/specializations/banking-and-finance", "permanent": true },
    { "source": "/specializations/business-ai", "destination": "/specializations/ai-for-business", "permanent": true },
    { "source": "/specializations/fintech", "destination": "/specializations/fintech-and-financial-services", "permanent": true },
    { "source": "/specializations/supply-chain", "destination": "/specializations/supply-chain-management", "permanent": true },
    { "source": "/specializations/sustainability-esg", "destination": "/specializations/sustainability-and-esg-management", "permanent": true },
    { "source": "/university-ignou-online", "destination": "/universities/ignou", "permanent": true },
    { "source": "/university-amity-online", "destination": "/universities/amity", "permanent": true },
    { "source": "/university-manipal-online", "destination": "/universities/manipal-jaipur", "permanent": true },
    { "source": "/university-du-sol-online", "destination": "/universities/du-sol", "permanent": true },
    { "source": "/university-gla-online", "destination": "/universities/gla", "permanent": true },
    { "source": "/university-andhra-online", "destination": "/universities/andhra-university", "permanent": true },
    { "source": "/university-ccsu-online", "destination": "/universities/ccsu", "permanent": true },
    { "source": "/university-parul-online", "destination": "/universities/parul", "permanent": true },
    { "source": "/university-chandigarh-online", "destination": "/universities/chandigarh-university", "permanent": true },
    { "source": "/university-chandigarh-university-online", "destination": "/universities/chandigarh-university", "permanent": true },
    { "source": "/university-imt-ghaziabad-online", "destination": "/universities/imt-ghaziabad", "permanent": true },
    { "source": "/university-symbiosis-online", "destination": "/universities/symbiosis", "permanent": true },
    { "source": "/university-kj-somaiya-online", "destination": "/universities/kj-somaiya", "permanent": true },
    { "source": "/university-imi-kolkata-online", "destination": "/universities/imi-kolkata", "permanent": true },
    { "source": "/universities/:univ/mba-in-:spec", "destination": "/university/:univ/mba-in-:spec", "permanent": true },
    { "source": "/university/:univ", "destination": "/universities/:univ", "permanent": true },
    { "source": "/contact", "destination": "/admission", "permanent": true },
    { "source": "/contact.html", "destination": "/admission", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.neodove.com; frame-src 'self' https://www.youtube.com https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|webp|svg|gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
